generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FeedbackEvent {
  id         String   @id @default(uuid())
  source     String
  receivedAt DateTime @default(now())
  status     String
  message    String

  projectContextId String?
  projectContext   ProjectContext? @relation(fields: [projectContextId], references: [id], onDelete: SetNull)


  operationsRecord OperationsRecord?
}

model OperationsRecord {
  id                  String   @id @default(uuid())
  eventId             String   @unique
  summary             String
  sentiment           String
  priority            String
  needsResponse       Boolean
  actionItems         Json
  risks               Json
  suggestedResponse   String
  confidence          String

  contextVersion      String?
  scopeAssesment      String?
  evidence            Json?
  assumptions         Json?
  missingInformation  Json?
  humanReviewReason   String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  event FeedbackEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model ProjectContext {
  id                String   @id @default(uuid())
  projectName       String
  clientName        String

  approvedScope     String
  outOfScope        String?
  constraints       String?
  deadline          DateTime?
  budgetNotes       String?
  communicationTone String?

  feedbackEvents    FeedbackEvent[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}